<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Users table</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>All users</h3>
            <p class="hint">Sample rows for layout only.</p>
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Techonology</th>
                  <th>percentage</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0;i<skill.length;i++){ %>
                 <tr>
                  <td><%= i+1 %></td>
                  <td><%= skill[i].s_tech%></td>
                  <td><%= skill[i].s_per%></td>
                  <td>
                  <a href="/admin/delete/<%=skill[i].sid%>"><span class="badge badge-ok">Delete</span></a>
                  <a href="/admin/edit/<%=skill[i].sid%>"  ><span class="badge badge-ok">Edit</span>
</a>
                </td>
                </tr>
                <% } %>
                  
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
<%-include('footer.ejs');%>