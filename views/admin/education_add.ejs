<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Add resume record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Education form</h3>
            <p class="hint">Static template only. Submit stays on this page.</p>

            <form class="form" action="/admin/education_save" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="name"> Year</label>
                  <input id="name" type="text" name="e_year" />
                </div>
                <div class="field">
                  <label for="text">Degree</label>
                  <input id="text" type="text"name="e_degree" placeholder="degree..." />
                </div>
              </div>
              <div class="field">
                <label for="text">University</label>
                <input id="text"name="e_university" placeholder="university..."/>
              </div>
              <div class="field">
                <label for="notes">Descripton</label>
                <textarea id="notes"name="e_desc" placeholder="Short note..."></textarea>
              </div>
              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>