<%-include('header.ejs');%>

      <div class="main">
        <header class="topbar">
          <h2>Add Skill record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Skill form</h3>
            <p class="hint">Static template only. Submit stays on this page.</p>

            <form class="form" action="/admin/skill_save" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="field">
                  <label for="name">Skill Tech</label>
                  <input id="name" type="text" name="s_tech" />
                </div>
                <div class="field">
                  <label for="text">Skill per</label>
                  <input id="text" type="text"name="s_per"  />
                </div>
              </div>
              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
    <%-include('footer.ejs');%>