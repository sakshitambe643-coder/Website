
<%- include('header.ejs'); %>

    <section class="section about" id="about">
      <div class="container">
        <div class="section-head">
          <div class="section-bg-title">About Me</div>
          <h2 class="section-title">Know Me More</h2>
        </div>
        <div class="about__grid">
          <div>
            <h3><%=data.a_title %></h3>
            <p><%= data.a_desc %></p>
            <ul class="about-meta">
              <li><strong>Name:</strong><%=data.a_name %></li>
              <li><strong>Email:</strong> <%=data.a_email %></li>
              <li><strong>Age:</strong> <%=data.a_age %></li>
              <li><strong>From:</strong><%=data.a_address %></li>
            </ul>
            <a class="btn btn--accent" href="#">Download CV</a>
          </div>
          <div class="stats">
            <div class="stat"><h2><%=data.a_title1 %></h2></div>
            <div class="stat"><h2><%=data.a_title2 %></h2></div>
            <div class="stat"><h2><%=data.a_title3 %></h2></div>
            <div class="stat"><h2><%=data.a_title4 %></h2></div>
          </div>
        </div>
    
      </div>
    </section>

    
    <%- include('footer.ejs'); %>